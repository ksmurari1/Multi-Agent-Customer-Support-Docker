# Copy this file to .env and add your real keys. Never commit .env.
OPENAI_API_KEY=your-openai-api-key
# Optional: Serper.dev key. If missing or rejected, the app falls back to DuckDuckGo automatically.
SERPER_API_KEY=your-serper-api-key
# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# auto = OpenAI embeddings when a key exists; local = free offline embeddings (BM25 still works either way)
EMBEDDINGS_BACKEND=auto
